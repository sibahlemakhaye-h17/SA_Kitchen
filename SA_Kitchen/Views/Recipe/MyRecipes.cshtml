@model IEnumerable<SA_Kitchen.ViewModels.RecipeViewModel>

@{
    ViewData["Title"] = "My Recipes";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-utensils"></i> My Recipes</h2>
            <p class="text-muted">Manage your recipes</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle"></i> Add New Recipe
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-utensils fa-4x text-muted mb-3"></i>
            <h3>You haven't shared any recipes yet</h3>
            <p class="text-muted">Share your first South African recipe with the community!</p>
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle"></i> Share Your Recipe
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var recipe in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow">
                        @if (!string.IsNullOrEmpty(recipe.RecipeImageUrl))
                        {
                            <img src="@recipe.RecipeImageUrl" class="card-img-top" alt="@recipe.Title" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-utensils fa-4x text-muted"></i>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">@recipe.Title</h5>
                                @if (!recipe.IsPublic)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-lock"></i> Private
                                    </span>
                                }
                            </div>

                            <p class="card-text text-muted small">@recipe.Description</p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <span class="badge bg-success">@recipe.CuisineType</span>
                                    <span class="badge bg-info">@recipe.DifficultyLevel</span>
                                </div>
                                <small class="text-muted">
                                    <i class="far fa-clock"></i> @recipe.TotalTime min
                                </small>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-sm btn-outline-success">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
}
