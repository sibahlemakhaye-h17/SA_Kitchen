@model SA_Kitchen.ViewModels.RecipeViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Recipe Header -->
            <div class="card shadow mb-4">
                @if (!string.IsNullOrEmpty(Model.RecipeImageUrl))
                {
                    <img src="@Model.RecipeImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                        <i class="fas fa-utensils fa-5x text-muted"></i>
                    </div>
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2 class="card-title">@Model.Title</h2>
                        @if (!Model.IsPublic)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="fas fa-lock"></i> Private
                            </span>
                        }
                    </div>

                    <p class="card-text">@Model.Description</p>

                    <!-- Recipe Meta Info -->
                    <div class="row mb-4">
                        <div class="col-md-3 text-center">
                            <div class="bg-light p-2 rounded">
                                <i class="fas fa-clock text-success"></i>
                                <h6 class="mb-0">@Model.TotalTime min</h6>
                                <small class="text-muted">Total Time</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="bg-light p-2 rounded">
                                <i class="fas fa-utensils text-success"></i>
                                <h6 class="mb-0">@Model.Servings</h6>
                                <small class="text-muted">Servings</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="bg-light p-2 rounded">
                                <i class="fas fa-tag text-success"></i>
                                <h6 class="mb-0">@Model.CuisineType</h6>
                                <small class="text-muted">Cuisine</small>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="bg-light p-2 rounded">
                                <i class="fas fa-signal text-success"></i>
                                <h6 class="mb-0">@Model.DifficultyLevel</h6>
                                <small class="text-muted">Difficulty</small>
                            </div>
                        </div>
                    </div>

                    <!-- Author Info -->
                    <div class="d-flex align-items-center mb-4 p-3 bg-light rounded">
                        @if (!string.IsNullOrEmpty(Model.UserProfilePicture))
                        {
                            <img src="@Model.UserProfilePicture" alt="@Model.UserName" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="fas fa-user text-white fa-2x"></i>
                            </div>
                        }
                        <div class="ms-3">
                            <h6 class="mb-0">@Model.UserName</h6>
                            <small class="text-muted">
                                <i class="far fa-calendar-alt"></i> Posted on @Model.CreatedAt.ToString("MMMM dd, yyyy")
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <span>| Updated: @Model.UpdatedAt.Value.ToString("MMMM dd, yyyy")</span>
                                }
                            </small>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || Model.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                    {
                        <div class="btn-group mb-3">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit Recipe
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Ingredients -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Ingredients</h5>
                </div>
                <div class="card-body">
                    <pre style="white-space: pre-wrap; font-family: inherit; font-size: inherit;">@Model.Ingredients</pre>
                </div>
            </div>

            <!-- Instructions -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-directions"></i> Instructions</h5>
                </div>
                <div class="card-body">
                    <pre style="white-space: pre-wrap; font-family: inherit; font-size: inherit;">@Model.Instructions</pre>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Quick Info</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-clock text-success"></i>
                            <strong>Prep Time:</strong> @Model.PrepTime minutes
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-clock text-success"></i>
                            <strong>Cook Time:</strong> @Model.CookTime minutes
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-users text-success"></i>
                            <strong>Servings:</strong> @Model.Servings
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-tag text-success"></i>
                            <strong>Cuisine:</strong> @Model.CuisineType
                        </li>
                        <li>
                            <i class="fas fa-signal text-success"></i>
                            <strong>Difficulty:</strong> @Model.DifficultyLevel
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-share-alt"></i> Share This Recipe</h5>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted">Share this delicious recipe with your friends!</p>
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-primary" onclick="shareRecipe()">
                            <i class="fas fa-share"></i> Share Recipe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function shareRecipe() {
        if (navigator.share) {
            navigator.share({
                title: '@Model.Title',
                text: 'Check out this delicious recipe: @Model.Title',
                url: window.location.href
            }).then(() => {
                console.log('Thanks for sharing!');
            }).catch((error) => {
                console.log('Error sharing:', error);
            });
        } else {
            // Fallback
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('Link copied to clipboard! Share it with your friends.');
            });
        }
    }
</script>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
}