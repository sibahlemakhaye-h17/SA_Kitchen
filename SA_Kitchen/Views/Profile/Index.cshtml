@model SA_Kitchen.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <!-- Profile Card -->
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl"
                                 alt="Profile Picture"
                                 class="rounded-circle img-fluid"
                                 style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #28a745;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 150px; height: 150px; border: 3px solid #28a745;">
                                <i class="fas fa-user fa-5x text-white"></i>
                            </div>
                        }
                    </div>

                    <h4 class="mt-3">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">
                        <i class="fas fa-envelope"></i> @Model.Email
                    </p>

                    @if (!string.IsNullOrEmpty(Model.Province))
                    {
                        <p class="text-muted">
                            <i class="fas fa-map-marker-alt"></i> @Model.Province
                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <span>, @Model.Country</span>
                            }
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(Model.FavoriteCuisine))
                    {
                        <p class="text-muted">
                            <i class="fas fa-utensils"></i> Favorite: @Model.FavoriteCuisine
                        </p>
                    }

                    <p class="text-muted small">
                        <i class="fas fa-calendar-alt"></i> Member since: @Model.CreatedAt.ToString("MMMM yyyy")
                    </p>

                    <a asp-action="Edit" class="btn btn-success btn-block w-100">
                        <i class="fas fa-edit"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <!-- Bio Section -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> About Me</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <p>@Model.Bio</p>
                    }
                    else
                    {
                        <p class="text-muted">No bio added yet. <a asp-action="Edit">Add your bio now!</a></p>
                    }
                </div>
            </div>

            <!-- Stats Section -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-bar"></i> My Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h3 class="text-success">0</h3>
                            <p class="text-muted">Recipes</p>
                        </div>
                        <div class="col-md-4">
                            <h3 class="text-success">0</h3>
                            <p class="text-muted">Followers</p>
                        </div>
                        <div class="col-md-4">
                            <h3 class="text-success">0</h3>
                            <p class="text-muted">Following</p>
                        </div>
                    </div>
                    <p class="text-muted text-center small mt-3">
                        <i class="fas fa-info-circle"></i> Stats will be updated as you share recipes and engage with the community!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
}
